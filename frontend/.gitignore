# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Playwright E2E suite output (tests/e2e/*.spec.ts is committed; its run
# artifacts are not)
/test-results/
/playwright-report/
/playwright/.cache/

# Intermediate output of `npm run codegen` (see README's "Regenerating API
# types from the backend") — regenerated on demand from the backend's own
# OpenAPI schema, so it isn't itself the source of truth worth committing.
# src/generated/api-schema.ts, which is generated *from* this file, IS
# committed — that's the actual file the rest of the frontend imports from.
/openapi.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
