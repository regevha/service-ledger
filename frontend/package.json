{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "codegen": "npx --yes openapi-typescript@7.13.0 openapi.json -o src/generated/api-schema.ts",
    "test:e2e:shuffled": "node scripts/run-e2e-shuffled.mjs",
    "coverage:report": "nyc report --temp-dir .nyc_output --reporter=text --reporter=html --reporter=json-summary --check-coverage --lines 88 --branches 70 --report-dir coverage",
    "test:e2e:coverage": "rm -rf .nyc_output coverage && COVERAGE=1 playwright test && npm run coverage:report",
    "test:e2e:coverage:shuffled": "rm -rf .nyc_output coverage && COVERAGE=1 node scripts/run-e2e-shuffled.mjs && npm run coverage:report"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "nyc": "^18.0.0",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-istanbul": "^9.0.1"
  }
}
