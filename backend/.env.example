# Copy to .env and adjust as needed.

# Postgres connection used by SQLAlchemy.
DATABASE_URL=postgresql+psycopg2://service_ledger:service_ledger_dev@localhost:5432/service_ledger

# Where scanned originals are stored for MVP (§8 of the spec: local disk in dev,
# swappable for an S3-compatible bucket later without touching the schema).
ATTACHMENT_STORAGE_DIR=./storage/attachments

# Confidence thresholds (§4/§12 of the spec). Classification defaults to a
# stricter threshold than field-level scoring, since a wrong report-type guess
# is the costliest failure in the pipeline (§4) — this is one of the open
# questions in §12, defaulted here rather than left unresolved.
FIELD_CONFIDENCE_THRESHOLD=0.7
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.85

# Set to "true" once ANTHROPIC_API_KEY is provided and services/classification.py
# and services/extraction.py have their real Claude calls wired in. While false,
# both services return deterministic stubbed results (see services/README.md).
USE_LIVE_CLAUDE=false
ANTHROPIC_API_KEY=

# The model both classify() and extract() call when USE_LIVE_CLAUDE=true — a
# single setting so a model bump touches one line instead of two call sites.
ANTHROPIC_MODEL=claude-sonnet-5

# How long to wait on one classify/extract call, and how many times the SDK
# retries a transient failure (connection error/timeout/429/5xx) internally
# before classify()/extract() raise ClassificationError/ExtractionError.
ANTHROPIC_TIMEOUT_SECONDS=90.0
ANTHROPIC_MAX_RETRIES=2

# Upload limits, checked before a file is written. Only a PDF or a PNG, JPEG,
# GIF or WebP image is accepted (decided from the file's own bytes). The
# Claude API caps a request at about 32 MB and images at about 5 MB each.
MAX_PDF_UPLOAD_BYTES=20971520
MAX_IMAGE_UPLOAD_BYTES=5242880
