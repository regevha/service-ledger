# Copy to .env and adjust as needed.

# Postgres connection used by SQLAlchemy.
DATABASE_URL=postgresql+psycopg2://service_ledger:service_ledger_dev@localhost:5432/service_ledger

# Where scanned originals are stored for MVP (§8 of the spec: local disk in dev,
# swappable for an S3-compatible bucket later without touching the schema).
ATTACHMENT_STORAGE_DIR=./storage/attachments

# Confidence thresholds (§4/§12 of the spec). Classification defaults to a
# stricter threshold than field-level scoring, since a wrong report-type guess
# is the costliest failure in the pipeline (§4) — this is one of the open
# questions in §12, defaulted here rather than left unresolved.
FIELD_CONFIDENCE_THRESHOLD=0.7
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.85

# Set to "true" once ANTHROPIC_API_KEY is provided and services/classification.py
# and services/extraction.py have their real Claude calls wired in. While false,
# both services return deterministic stubbed results (see services/README.md).
USE_LIVE_CLAUDE=false

# Debug aid: with true, each live Claude call first stops and the intake screen shows
# the exact prompt; press Send to make the call or Cancel to drop it.
VIEW_PROMPTS=false
ANTHROPIC_API_KEY=

# Stub mode only (ignored when USE_LIVE_CLAUDE=true). true (the default):
# extraction reads the PDF's own text (services/text_extraction.py, BD Care
# work-order layout) and leaves what it cannot read empty at confidence 0; a
# scan with no text fails and asks for a key. false: extraction invents
# plausible values, for demos with placeholder files.
STUB_EXTRACT_FROM_TEXT=true

# The model both classify() and extract() call when USE_LIVE_CLAUDE=true — a
# single setting so a model bump touches one line instead of two call sites.
ANTHROPIC_MODEL=claude-sonnet-5

# Model-backed search (docs: claude/proposal-model-backed-search.md). When a plain-words question on the
# Reports screen leaves words the built-in rules cannot place, one small call to this cheaper model turns it
# into filters. Needs USE_LIVE_CLAUDE=true as well. Off by default. Failure, a timeout or the daily cap fall
# back to the rules, so search keeps working. The cap counts questions sent to the model per UTC day (0 = none).
SEARCH_MODEL_ENABLED=false
ANTHROPIC_SEARCH_MODEL=claude-haiku-5-5
SEARCH_MODEL_TIMEOUT_SECONDS=15.0
SEARCH_MODEL_MAX_TOKENS=400
SEARCH_MODEL_DAILY_CAP=500

# How long to wait on one classify/extract call, and how many times the SDK
# retries a transient failure (connection error/timeout/429/5xx) internally
# before classify()/extract() raise ClassificationError/ExtractionError.
ANTHROPIC_TIMEOUT_SECONDS=90.0
ANTHROPIC_MAX_RETRIES=2

# Upload limits, checked before a file is written. Only a PDF or a PNG, JPEG,
# GIF or WebP image is accepted (decided from the file's own bytes). The
# Claude API caps a request at about 32 MB and images at about 5 MB each.
MAX_PDF_UPLOAD_BYTES=20971520
MAX_IMAGE_UPLOAD_BYTES=5242880

# Email intake: off until explicitly configured. Folder mode needs no network.
EMAIL_INTAKE_ENABLED=false
# Optional for loopback-only development with Gmail and no shared password.
EMAIL_INTAKE_LOCAL_NO_AUTH=false
EMAIL_MAILBOX=folder
EMAIL_SENDER=folder
EMAIL_FAKE_INBOX_DIR=./storage/email/inbox
EMAIL_FAKE_OUTBOX_DIR=./storage/email/outbox
EMAIL_INTAKE_ADDRESS=intake@example.invalid
# HTTPS address of the password-protected app, or a loopback URL in local Gmail mode.
EMAIL_REPORT_BASE_URL=
EMAIL_TRUSTED_AUTHSERV_ID=
EMAIL_MAX_MESSAGE_BYTES=52428800
EMAIL_MAX_PDFS_PER_MESSAGE=10
EMAIL_MAX_OTHER_FILES_PER_MESSAGE=10
EMAIL_MAX_MESSAGES_PER_SENDER_PER_HOUR=20
EMAIL_LOG_RETENTION_DAYS=90
EMAIL_POLL_INTERVAL_SECONDS=60
# Gmail demonstrator: dedicated mailbox, app password, IMAP TLS and SMTP TLS.
# Switch EMAIL_MAILBOX=imap, EMAIL_SENDER=smtp and trusted authserv-id=mx.google.com.
# Confirm the account's localized Trash folder name and UID MOVE support first.
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_FOLDER=INBOX
EMAIL_IMAP_TRASH_FOLDER=[Gmail]/Trash
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_USERNAME=
EMAIL_APP_PASSWORD=
